{
  "name": "archdoc-monorepo",
  "private": true,
  "description": "ArchDoc: an architecture control plane for AI-assisted development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchDoc/archdoc.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "archdoc": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
