{
  "name": "archdoc-monorepo",
  "private": true,
  "description": "ArchDoc: an architecture control plane for AI-assisted development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchDoc/archdoc.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b && pnpm -F @archdoc/web build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/web",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "archdoc": "node packages/cli/dist/bin.js",
    "playground": "node scripts/playground.mjs",
    "smoke": "node scripts/smoke-pack.mjs",
    "release": "node scripts/release.mjs",
    "set-version": "node scripts/set-version.mjs",
    "replay-prs": "node scripts/replay-prs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "playwright-core": "1.64.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
