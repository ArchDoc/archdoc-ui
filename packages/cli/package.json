{
  "name": "@archdoc/cli",
  "version": "0.0.0",
  "description": "The archdoc command-line tool.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchDoc/archdoc.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "web"
  ],
  "bin": {
    "archdoc": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@archdoc/core": "workspace:*",
    "@archdoc/spec": "workspace:*",
    "commander": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('node:fs');fs.rmSync('web',{recursive:true,force:true});fs.cpSync('../../apps/web/dist','web',{recursive:true})\""
  }
}
