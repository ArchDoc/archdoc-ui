{
  "name": "@archdoc/core",
  "version": "0.1.1",
  "description": "The deterministic ArchDoc engine: load, validate, and query architecture models.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchDoc/archdoc.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.12"
  },
