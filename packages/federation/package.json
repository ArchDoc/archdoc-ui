{
  "name": "@archdoc/federation",
  "version": "0.0.0",
  "description": "Share ArchDoc models across repos: publish a bundle, and sync other repos' models into archdoc.lock.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchDoc/archdoc.git",
    "directory": "packages/federation"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@archdoc/core": "workspace:*",
    "@archdoc/spec": "workspace:*",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  }
}
